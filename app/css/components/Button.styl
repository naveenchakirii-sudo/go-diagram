buttonColor = rgba(white, 0.3)
buttonBorderRadius = 10px

.Button
  color #333
  background-color buttonColor
  border none
  border-radius buttonBorderRadius
  cursor pointer
  font-size 16px
  line-height 1
  &:hover
    background-color rgba(white, 0.5)

.zoom-controls
  position absolute
  right 10px
  bottom 10px
  display flex
  flex-direction column
  gap 6px
  .Button
    width 32px
    height 32px
