colorHomeBackground = #333
bannerMargin = 10px

.App
  width 100%
  height 100%
  position relative
  overflow hidden
  background-color colorHomeBackground

.banner
  position absolute
  top bannerMargin
  left 50%
  transform translateX(-50%)
  padding 8px 14px
  border-radius 6px
  font-size 13px
  color white
  display flex
  gap 12px
  align-items center
  max-width 80%
  box-shadow 0 2px 10px rgba(0, 0, 0, .4)
  &.status
    background-color rgba(0, 0, 0, 0.5)
  &.error
    top (bannerMargin + 44px)
    background-color rgb(192, 57, 43)
    white-space pre-wrap
    button
      background none
      border none
      color white
      font-size 18px
      cursor pointer

.help
  position absolute
  bottom bannerMargin
  left bannerMargin
  font-size 12px
  color rgba(255, 255, 255, 0.55)
  background-color rgba(0, 0, 0, 0.35)
  padding 4px 10px
  border-radius 4px
  pointer-events none
